{
  "expo": {
    "name": "gymi",
    "slug": "gymi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5F8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liord222.gymi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "To take a photo for Eilon, the coach: of a gym machine, to ask about it, or of you, to make your character.",
        "NSPhotoLibraryUsageDescription": "To choose a photo for Eilon, the coach: of a gym machine, to ask about it, or of you, to make your character.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.liord222.gymi",
      "adaptiveIcon": {
        "backgroundColor": "#6D3FE0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F8",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0B0A0F"
          }
        }
      ],
      "./plugins/withCameraQuery"
    ],
    "locales": {
      "he": "./locales/he.json",
      "en": "./locales/en.json"
    }
  }
}
