{
  "expo": {
    "name": "gymi",
    "slug": "gymi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F3F5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liord222.gymi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "כדי לצלם מכשיר בחדר הכושר ולשאול את אילון עליו.",
        "NSPhotoLibraryUsageDescription": "כדי לבחור תמונה של מכשיר ולשאול את אילון עליה."
      }
    },
    "android": {
      "package": "com.liord222.gymi",
      "adaptiveIcon": {
        "backgroundColor": "#2152E0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-secure-store"
    ]
  }
}
